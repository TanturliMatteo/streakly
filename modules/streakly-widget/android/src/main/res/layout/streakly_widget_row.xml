<?xml version="1.0" encoding="utf-8"?>
<!-- One habit: card with icon, name, streak / description and the round check. 8dp below each card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="60dp"
  android:paddingBottom="8dp">

  <ImageView
    android:id="@+id/row_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/streakly_widget_card" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="4dp">

    <!-- Icon + texts: open the habit in the app. -->
    <LinearLayout
      android:id="@+id/row_open"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="10dp">

        <ImageView
          android:id="@+id/row_icon_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:src="@drawable/streakly_widget_dot" />

        <TextView
          android:id="@+id/row_icon"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:textSize="17sp" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/row_name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textSize="15sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/row_subtitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>

    <!-- Check: toggles today's done / not done (ring when open, filled with a tick when done). -->
    <FrameLayout
      android:id="@+id/row_check"
      android:layout_width="44dp"
      android:layout_height="match_parent">

      <ImageView
        android:id="@+id/row_check_ring"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/streakly_widget_ring" />

      <ImageView
        android:id="@+id/row_check_fill"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/streakly_widget_dot" />

      <TextView
        android:id="@+id/row_check_mark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="✓"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
    </FrameLayout>
  </LinearLayout>
</FrameLayout>
